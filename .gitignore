# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

/~

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build
/dist

# editors
# ignore the IDE folder except the shared run configurations
/.idea/*
!/.idea/runConfigurations
/.vscode

# cloudflare
# .wrangler holds the local D1 sqlite file and build state; .dev.vars holds the
# GitHub client secret for local development and must never be committed.
/.wrangler
.dev.vars

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
